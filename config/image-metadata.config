# Static ExifTool definitions for common PNG generation fields. No user input is
# evaluated as Perl. Unregistered fields outside this list fail verification.
%Image::ExifTool::UserDefined = (
  'Image::ExifTool::XMP::Main' => {
    dcterms => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::dcterms' } },
  },
  'Image::ExifTool::PNG::TextualData' => {
    prompt => { Name => 'Prompt' },
    negative_prompt => { Name => 'NegativePrompt' },
    workflow => { Name => 'Workflow' },
    seed => { Name => 'Seed' },
    model => { Name => 'Model' },
    model_name => { Name => 'ModelName' },
    model_hash => { Name => 'ModelHash' },
    sampler => { Name => 'Sampler' },
    steps => { Name => 'Steps' },
    cfg => { Name => 'CFG' },
    cfg_scale => { Name => 'CFGScale' },
    scheduler => { Name => 'Scheduler' },
    generation_details => { Name => 'GenerationDetails' },
  },
);
%Image::ExifTool::UserDefined::dcterms = (
  GROUPS => { 0 => 'XMP', 1 => 'XMP-dcterms', 2 => 'Image' },
  NAMESPACE => { 'dcterms' => 'http://purl.org/dc/terms/' },
  WRITABLE => 'string',
  provenance => { Name => 'Provenance' },
);
1;
