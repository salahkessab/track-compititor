{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "skipMiddlewareRequestBody": true,
  "git": { "deploymentEnabled": { "claude/article-image-experiment": false } },
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "track-compititor.vercel.app" }],
      "destination": "https://3000-agq44rg6nmhmxmq3i7xitgmpza.instabox.tech/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
