# Required for OpenAI text and image generation. Server-side only.
OPENAI_API_KEY=
# Set a password before exposing the app to other people.
APP_PASSWORD=
# Optional: fal image models and hosted URLs for posting CSV exports.
FAL_KEY=

# Optional private R2 object storage. Server-side only; NEVER use NEXT_PUBLIC_.
# Local files and SQLite remain available with this disabled.
R2_ENABLED=0
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=track-competitor
# Optional jurisdiction-specific endpoint; omit for an Automatic/default bucket.
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com

# Persistent Node server only (not Vercel/serverless). Leave unset for Windows.
# RECIPE_INTELLIGENCE_MODE=server
# RECIPE_INTELLIGENCE_ROOT=/var/lib/recipe-intelligence
# RECIPE_INTELLIGENCE_ORIGIN=https://recipes.your-domain.com
# SERVER_DOMAIN=recipes.your-domain.com
# RECIPE_INTELLIGENCE_SECRET_KEY=<permanent 32-byte base64 key>
# RECIPE_INTELLIGENCE_MIGRATION_KEY=track-competitor/migrations/<id>.ribak
# RECIPE_INTELLIGENCE_MIGRATION_SHA256=<encrypted backup checksum>
# Keep processing paused during migration verification; remove after cutover.
# RECIPE_INTELLIGENCE_WORKER_PAUSED=1
# Set only for a deliberately empty installation, never as migration fallback.
# RECIPE_INTELLIGENCE_ALLOW_EMPTY=1
